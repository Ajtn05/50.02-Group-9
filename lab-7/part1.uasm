.include beta.uasm

    LD(INPUT, R0)           | R0 = number of values remaining
    CMOVE(INPUT+4, R1)      | R1 = address of the current value
    CMOVE(0, R3)            | R3 = running sum of odd values
    CMOVE(0, R4)            | R4 = running sum of even values
    CMPLEC(R0, 0, R5)       | check if there are still remaining values
    BT(R5, DONE)            | if there aren't, move to DONE

LOOP:
    LD(R1, 0, R2)           | R2 = current array value
    ANDC(R2, 1, R5)         | removes higher bits, leaving rightmost, which is only 1 when rightmost bit of current value is 1, meaning odd
    BEQ(R5, EVEN)           
    ADD(R3, R2, R3)
    BR(NEXT)

EVEN:
    ADD(R4, R2, R4)

NEXT:
    ADDC(R1, 4, R1)         | Advance to the next 32-bit value
    SUBC(R0, 1, R0)
    BNE(R0, LOOP)

DONE:
    ST(R3, ODDSUM)
    ST(R4, EVENSUM)
    HALT()

. = 0x19C
INPUT:
    LONG(7)                | Array length N
    LONG(5)
    LONG(7)
    LONG(8)
    LONG(6)
    LONG(4)
    LONG(9)
    LONG(3)

ODDSUM:
    LONG(0)

EVENSUM:
    LONG(0)
