.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* Full adder (from lab 4)
* sum   = a XOR b XOR carry_in
* carry = a*b + (a XOR b)*carry_in, built as NAND(NAND(a,b), NAND(p,carry_in))
*         because by De Morgan, a NAND of two NANDs is an OR of the two ANDs
*******************************************************************************
.subckt fa a b carry_in sum carry
    Xh1 a b p xor2
    Xh2 p carry_in sum xor2
    Xh3 a b nab nand2
    Xh4 p carry_in npc nand2
    Xh5 nab npc carry nand2
.ends

*******************************************************************************
* 32-bit ripple-carry adder (from lab 4)
* Bit i takes its carry-in from bit i-1's carry-out; bit 0 takes cin0.
* c[31:30] are exposed because as32 needs them for the overflow flag.
*******************************************************************************
.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] c[31:30]
    Xf a[31:0] b[31:0] c[30:0] cin0 sum[31:0] c[31:0] fa
.ends

*******************************************************************************
* as32: 32-bit adder/subtractor
* inputs:  a[31:0], b[31:0], op0 (0 = add, 1 = subtract)
* outputs: fas[31:0], n, v, z
*
* Subtraction: a - b = a + (-b) = a + ~b + 1 (two's complement negation).
*  - 32 mux2s pick b when op0 = 0 and ~b when op0 = 1.
*  - op0 also drives add32's carry-in, so subtraction gets its "+1" for free
*    and addition gets a carry-in of 0. Only one add32 is needed.
*
* n (negative): fas31 is the sign bit of a two's complement number, so the
*   result is negative exactly when fas31 = 1. No gate is needed.
*
* v (signed overflow): c31 XOR c30. c30 is the carry into the sign bit and
*   c31 is the carry out of it. They differ only when the true result does
*   not fit in 32 bits (pos + pos gave a negative sign, or neg + neg gave a
*   non-negative sign). When they agree, the sign bit is correct.
*
* z (zero): z = NOT(fas31 OR fas30 OR ... OR fas0), so z = 1 only when every
*   bit is 0. stdcell gates have at most 4 inputs, so this is a 3-level tree
*   built only from NOR/NAND gates:
*       - level 1: 8 nor4s,  each 1 when its 4 bits are all 0
*       - level 2: 2 nand4s, each 1 when its 16-bit half has any nonzero bit
*       - level 3: 1 nor2,   1 when neither half has a nonzero bit
*   This is the minimum possible: a gate merges at most 4 signals into 1, so
*   reducing 32 signals to 1 takes at least ceil(31/3) = 11 gates, and at
*   least 3 levels since two levels reach only 4 x 4 = 16 inputs.
*******************************************************************************
.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z
    Xinv b[31:0] b_inverse[31:0] inverter
    Xmux op0#32 b[31:0] b_inverse[31:0] b_selected[31:0] mux2

    Xadd a[31:0] b_selected[31:0] op0 fas[31:0] c31 c30 add32

    .connect fas[31] n
    Xv c30 c31 v xor2

    Xza fas[31:28] za nor4
    Xzb fas[27:24] zb nor4
    Xzc fas[23:20] zc nor4
    Xzd fas[19:16] zd nor4
    Xze fas[15:12] ze nor4
    Xzf fas[11:8]  zf nor4
    Xzg fas[7:4]   zg nor4
    Xzh fas[3:0]   zh nor4


    Xupper za zb zc zd upper_nonzero nand4
    Xlower ze zf zg zh lower_nonzero nand4

    Xz upper_nonzero lower_nonzero z nor2
.ends

*******************************************************************************
* cmp32: 32-bit comparator
* inputs:  n, v, z from the as32 placed directly before it (computing a - b),
*          op[2:1]
* outputs: fcmp[31:0]; only fcmp0 carries the answer, fcmp[31:1] are ground
*
*   op2 op1 | fcmp0
*    0   1  | 1 iff a = b
*    1   0  | 1 iff a < b
*    1   1  | 1 iff a <= b
*
*   - a = b:  a - b = 0, so check z.
*   - a < b:  a - b < 0, so normally check n. But if the subtraction overflowed
*         (v = 1), the sign bit came out flipped and n is wrong. XOR-ing with
*         v undoes the flip: lt = n XOR v.
*   - a <= b: (a < b) OR (a = b), so turning on both op bits ORs both checks.
*
* fcmp0 = op1*z + op2*lt. The AND-OR is built as NAND-NAND (De Morgan:
* NAND(NAND(x,y), NAND(p,q)) = x*y + p*q), the same function with smaller,
* faster gates than and2/or2
*******************************************************************************
.subckt cmp32 n v z op[2:1] fcmp[31:0]
    .connect 0 fcmp[31:1]
    Xlt n v lt xor2
    Xeq op[1] z eq_n nand2
    Xless op[2] lt lt_n nand2
    Xresult eq_n lt_n fcmp[0] nand2
.ends

*******************************************************************************
* bool32: 32-bit bitwise Boolean circuit
* Each a/b bit-pair selects one of the four truth-table outputs in op.
* mux4 port order: s0 s1 d0 d1 d2 d3 z.
* With s0 = a_i and s1 = b_i, fbool_i = op[a_i + 2*b_i].
*
* op[3:0]: XOR = 0110, NAND = 0111, NOR = 0001, NOT B = 0011.
* Other settings include AND = 1000, OR = 1110, A = 1010, NOT A = 0101.
* The vector instance below expands into 32 parallel mux4 gates.
* .connect shares each op bit across a bus of 32 mux data inputs.
* These connections are wire aliases and add no gates.
*******************************************************************************
.subckt bool32 a[31:0] b[31:0] op[3:0] fbool[31:0]
    .connect op[0] d0[31:0]
    .connect op[1] d1[31:0]
    .connect op[2] d2[31:0]
    .connect op[3] d3[31:0]

    Xbool a[31:0] b[31:0] d0[31:0] d1[31:0] d2[31:0] d3[31:0] fbool[31:0] mux4
.ends

